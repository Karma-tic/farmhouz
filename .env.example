# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables

# REQUIRED for bookings: any Postgres (Neon via Vercel Storage sets this automatically)
DATABASE_URL=

# REQUIRED for /admin
ADMIN_PASSWORD=
# Long random string used to sign the admin login cookie
ADMIN_SECRET=

# UPI details shown on the payment step
NEXT_PUBLIC_UPI_ID=
NEXT_PUBLIC_UPI_NAME=Farmhouze

# Optional: email notifications via Resend (https://resend.com)
RESEND_API_KEY=
ADMIN_EMAIL=
EMAIL_FROM=

# Your public URL, used in links and the sitemap (defaults to https://farmhouz.vercel.app)
NEXT_PUBLIC_SITE_URL=
