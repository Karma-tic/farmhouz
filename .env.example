# Copy to .env.local (and add the same keys in Vercel → Project → Settings → Environment Variables)

# Optional: send enquiry emails with Resend (https://resend.com). Without it, enquiries are logged on the server.
RESEND_API_KEY=
# Who receives enquiries (defaults to site.contact.email)
ENQUIRY_TO=
# Verified sender in Resend, e.g. "Farmhouze <bookings@yourdomain.com>" (defaults to Resend's onboarding sender)
ENQUIRY_FROM=

# Optional: public Google Calendar ICS link. Events block those dates in the availability calendar (cached 15 min).
# Google Calendar → Settings → your calendar → "Public address in iCal format"
NEXT_PUBLIC_ICS_URL=
